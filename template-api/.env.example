# ==========================================================================
#  .env.example - SZABLON ZMIENNYCH SRODOWISKOWYCH
# --------------------------------------------------------------------------
#  Ten plik JEST commitowany do repozytorium - sluzy jako dokumentacja.
#  Prawdziwe wartosci trzymaj w pliku .env, ktory .gitignore pomija.
#
#  Start pracy:  cp .env.example .env
# ==========================================================================

# Port, na ktorym nasluchuje API.
PORT=4000

# Adresy frontendow, ktore moga odpytywac to API (CORS), po przecinku.
# 5173 = wariant kinowy, 5174 = wariant klasyczny.
# UWAGA: na produkcji wpisz realne domeny klienta, nigdy gwiazdke.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Adres webhooka n8n. Puste = integracja wylaczona.
# Wygenerujesz go w panelu n8n: http://localhost:5678
N8N_WEBHOOK_URL=
