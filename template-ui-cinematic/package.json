{
  "name": "template-ui-cinematic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aios Studio - Wariant A (Kinowy): dark luxury, wideo w tle, kalkulator wyceny na zywo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "optimize-video": "ffmpeg -y -i public/videos/raw.mp4 -vcodec libx264 -crf 23 -g 1 -pix_fmt yuv420p -movflags +faststart -an public/videos/bg.mp4"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9",
    "vite": "^8.2.2"
  }
}
