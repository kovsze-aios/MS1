# ==========================================================================
#  .env.example - WZORZEC ZMIENNYCH SRODOWISKOWYCH (wariant kinowy)
# --------------------------------------------------------------------------
#  Skopiuj do .env i uzupelnij. Plik .env jest ignorowany przez Git.
#  Vite udostepnia w przegladarce WYLACZNIE zmienne z prefiksem VITE_.
#
#  Na Vercelu: Settings -> Environment Variables. Zmienne sa wstrzykiwane
#  w czasie BUILDU, wiec po ich zmianie trzeba wywolac Redeploy.
# ==========================================================================

# Adres backendu (template-api). Puste = tryb demo bez zapytan sieciowych.
VITE_API_URL=http://localhost:4000

# --------------------------------------------------------------------------
#  SILNIK REZERWACJI
# --------------------------------------------------------------------------
# Endpoint przyjmujacy zgloszenia z formularza. Puste = adres wpisany
# w companyConfig.bookingConfig.webhookUrl (aktualnie: Google Apps Script).
#
# Sciezka A - Google Apps Script (domyslna, zero infrastruktury):
#   VITE_BOOKING_WEBHOOK_URL=https://script.google.com/macros/s/TWOJE_ID/exec
#
# Sciezka B - n8n (wymaga publicznego HTTPS, nie localhost!):
#   VITE_BOOKING_WEBHOOK_URL=https://n8n.twojadomena.pl/webhook/rezerwacje
#
# Porownanie obu sciezek: automatyzacje/README.md
VITE_BOOKING_WEBHOOK_URL=
